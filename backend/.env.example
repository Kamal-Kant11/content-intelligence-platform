# Copy this file to .env and fill in your values. Never commit .env.

PORT=5000

# Local MongoDB, or your MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/contentiq

# Any long random string (signs the login cookie)
JWT_SECRET=change_me_to_a_long_random_string

# URL of the React app (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Grammar checking server (LanguageTool).
#   Public API (no setup, rate-limited, your text is sent to languagetool.org):
LANGUAGETOOL_URL=https://api.languagetool.org
#   Your own server (see README, "Running LanguageTool locally"):
# LANGUAGETOOL_URL=http://localhost:8081
LANGUAGETOOL_LANGUAGE=en-US

# Optional: maximum characters per document (default 20000)
# MAX_TEXT_CHARS=20000

# Optional: set to true when the site is served over HTTPS (automatic when NODE_ENV=production)
# COOKIE_SECURE=false
