# Copy this file to .env and fill in your values. Never commit .env.

PORT=5000

# Local MongoDB, or your MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/ai_content_assurance

# Any long random string
JWT_SECRET=change_me_to_a_long_random_string

# URL of the React app (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Optional: folder with the trained models (default: backend/ml/models)
# MODEL_DIR=

# Optional: allow URL input to fetch localhost / private network pages (default false)
# ALLOW_PRIVATE_URLS=false
